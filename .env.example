# Root env reference — copy to backend/.env and frontend/.env

# Backend
DATABASE_URL=postgresql://postgres:dev@localhost:5432/forge_dev
JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h
REFRESH_SECRET=change-me-refresh-in-production
REFRESH_EXPIRY=7d
PORT=3001
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx

# Optional Datadog
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com

# Frontend
VITE_API_URL=http://localhost:3001/api
